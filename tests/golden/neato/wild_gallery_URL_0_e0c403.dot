graph {
	graph [URL="https://en.wikipedia.org/wiki/Vincent_van_Gogh",
		bb="0,0,409.4,258.8",
		label="Vincent van Gogh Paintings",
		layout=neato,
		lheight=0.23,
		lp="204.7,12.4",
		lwidth=2.20
	];
	node [label="\N"];
	subgraph cluster_self_portraits {
		graph [URL="https://en.wikipedia.org/wiki/Portraits_of_Vincent_van_Gogh",
			bb="0,101.8,409.4,214.8",
			label="Self-portraits",
			lheight=0.23,
			lp="204.7,202.4",
			lwidth=1.03
		];
		"Self-Portrait with Grey Felt Hat"	[URL="https://www.vangoghmuseum.nl/en/collection/s0016V1962",
			height=0.5,
			pos="133.87,119.8",
			width=3.7186];
		"Self-Portrait as a Painter"	[URL="https://www.vangoghmuseum.nl/en/collection/s0022V1962",
			height=0.5,
			pos="303.7,196.8",
			width=2.9361];
	}
	subgraph cluster_flowers {
		graph [URL="https://en.wikipedia.org/wiki/Sunflowers_(Van_Gogh_series)",
			bb="44,24.8,300.83,258.8",
			label=Flowers,
			lheight=0.23,
			lp="172.41,246.4",
			lwidth=0.63
		];
		Sunflowers	[URL="https://www.nationalgallery.org.uk/paintings/vincent-van-gogh-sunflowers",
			height=0.5,
			pos="99.026,240.8",
			width=1.5285];
		"Almond Blossom"	[URL="https://www.vangoghmuseum.nl/en/collection/s0176V1962",
			height=0.5,
			pos="221.91,42.8",
			width=2.192];
	}
}
