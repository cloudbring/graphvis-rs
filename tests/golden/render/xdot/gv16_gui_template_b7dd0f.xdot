strict digraph template {
	graph [_draw_="c 9 -#fffffe00 C 7 -#ffffff P 4 0 0 0 108 54 108 54 0 ",
		antialiasing=1,
		bb="0,0,54,108",
		bgcolor="#ffffff",
		bordercolor="#38eb29",
		bordercoloralpha=1,
		bordervisible=1,
		colortheme=1,
		defaultedgealpha=0.5,
		defaultedgecolor=purple,
		defaultfisheyemagnifierdistort=5,
		defaultfisheyemagnifierradius=250,
		defaultfontname=1,
		defaultfontsize=52,
		defaultlinewidth=1,
		defaultmagnifierheight=200,
		defaultmagnifierkts=5,
		defaultmagnifierwidth=300,
		defaultnodealpha=1,
		defaultnodecolor=blue,
		defaultnodeshape=0,
		defaultselectionmethod=2,
		drawedges=1,
		drawnodes=1,
		edgecolorattribute="",
		edgelabelattribute=name,
		edgelabelcolor="#000000",
		edgerender=0,
		edgesselectable=1,
		gridcolor="#6033d8",
		gridcoloralpha=1,
		gridsize=30,
		gridvisible=0,
		labelglutfont=0,
		labelnumberofnodes=45,
		labelshowedges=0,
		labelshownodes=0,
		nodelabelattribute=name,
		nodelabelcolor="#000000",
		nodesize=5,
		nodesizewithdegree=1,
		nodesselectable=1,
		selectednodecolor="#8ce61d",
		selectednodecoloralpha=1,
		topologicalfisheyeanimate=1,
		topologicalfisheyecoarseningfactor=2.5,
		topologicalfisheyecoarsestcolor=green,
		topologicalfisheyecoloredges=1,
		topologicalfisheyecolornodes=1,
		topologicalfisheyedist2limit=1,
		topologicalfisheyedistortionfactor=1,
		topologicalfisheyefinenodes=50,
		topologicalfisheyefinestcolor=red,
		topologicalfisheyelabelattribute=label,
		topologicalfisheyelabelfinenodes=1,
		topologicalfisheyelabelfocus=1,
		usermode=1,
		xdotversion=1.7
	];
	node [label="\N"];
	A	[_draw_="c 7 -#000000 e 27 90 27 18 ",
		_ldraw_="F 14 11 -Times-Roman c 7 -#000000 T 27 85.8 0 10.11 1 -A ",
		height=0.5,
		pos="27,90",
		width=0.75];
	B	[_draw_="c 7 -#000000 e 27 18 27 18 ",
		_ldraw_="F 14 11 -Times-Roman c 7 -#000000 T 27 13.8 0 9.34 1 -B ",
		height=0.5,
		pos="27,18",
		width=0.75];
	A -> B	[_draw_="c 7 -#000000 B 4 27 71.7 27 64.41 27 55.73 27 47.54 ",
		_hdraw_="S 5 -solid c 7 -#000000 C 7 -#000000 P 3 30.5 47.62 27 37.62 23.5 47.62 ",
		pos="e,27,36.104 27,71.697 27,64.407 27,55.726 27,47.536"];
}
