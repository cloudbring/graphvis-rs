graph grid4x4 {
layout=neato;

overlap=portho; node [shape=box, width=1.5];
node [shape=point];
n0_0 -- n0_1;
n0_0 -- n1_0;
n0_1 -- n0_2;
n0_1 -- n1_1;
n0_2 -- n0_3;
n0_2 -- n1_2;
n0_3 -- n1_3;
n1_0 -- n1_1;
n1_0 -- n2_0;
n1_1 -- n1_2;
n1_1 -- n2_1;
n1_2 -- n1_3;
n1_2 -- n2_2;
n1_3 -- n2_3;
n2_0 -- n2_1;
n2_0 -- n3_0;
n2_1 -- n2_2;
n2_1 -- n3_1;
n2_2 -- n2_3;
n2_2 -- n3_2;
n2_3 -- n3_3;
n3_0 -- n3_1;
n3_1 -- n3_2;
n3_2 -- n3_3;
}