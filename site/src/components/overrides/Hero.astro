---
/**
 * The home page's hero: the claim, set in Times-Roman (the face Graphviz has defaulted to
 * since 1991), over a live graph of this site that the port lays out in the reader's browser.
 * Starlight's 404 page is also a splash page with a hero, but one with only a tagline; it gets
 * a plain heading instead of the claim, which assumes the home page's title and figures.
 */
import { latest } from '../../lib/changelog';
import { url } from '../../lib/data';
import LiveGraph from '../home/LiveGraph.astro';

const { title, hero } = Astro.locals.starlightRoute.entry.data;
---

{!hero?.title ? (
<section class="hero plain">
	<p class="label">{title}</p>
	<h1 id="_top">{hero?.tagline ?? title}</h1>
	<div class="actions">
		<a class="btn primary" href={url()}>Go to the overview</a>
		<a class="btn" href={url('gallery/')}>Compare C and Rust</a>
	</div>
</section>
) : (
<section class="hero">
	<div class="claim">
		<p class="label">
			Graphviz 16.1.0, ported to Rust and WebAssembly
			{latest && <a class="version" href={url('changelog/')}>v{latest.version}</a>}
		</p>
		<h1 id="_top">{hero.title} <em>{hero.tagline}</em></h1>
		<div class="side">
			<p class="lead">
				Give graphviz-pure the DOT file you would give Graphviz, and it draws the same picture: from the command line, inside a Rust
				program, or in JavaScript on a server or in a browser tab. Unlike Graphviz, the picture is the same on every machine.
			</p>
			<div class="actions">
				<a class="btn primary" href="#get-started">Get started</a>
				<a class="btn" href={url('gallery/')}>Compare it with Graphviz</a>
			</div>
		</div>
	</div>
	<LiveGraph />
</section>
)}

<style>
	:global(:root[data-has-hero]:not([data-has-sidebar])) {
		--sl-content-width: 80rem;
	}
	.hero {
		padding-block: 0.5rem 0;
	}
	.claim {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 3rem;
		align-items: end;
	}
	.plain {
		padding-block: 2rem 4rem;
	}
	.plain .label {
		margin: 0 0 0.75rem;
	}
	.plain h1 {
		font-size: clamp(2rem, 3vw, 2.75rem);
		line-height: 1.1;
		white-space: normal;
		text-wrap: balance;
		max-width: 40rem;
	}
	.plain .actions {
		margin-top: 2rem;
	}
	.claim .label {
		grid-column: 1 / -1;
		margin: 0 0 0.75rem;
	}
	h1 {
		margin: 0;
		font-family: Times, Tinos, 'Times New Roman', serif;
		font-weight: 400;
		font-stretch: 100%;
		font-size: clamp(2.5rem, 4.3vw, 3.875rem);
		line-height: 1;
		letter-spacing: -0.018em;
		color: var(--key);
		white-space: nowrap;
	}
	h1 em {
		display: block;
		margin-top: 0.08em;
		font-style: italic;
		color: var(--key-3);
	}
	.side {
		padding-bottom: 0.375rem;
	}
	.lead {
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		color: var(--key-2);
		max-width: 28rem;
	}
	.version {
		margin-left: 0.5rem;
		padding: 0.0625rem 0.375rem;
		border: 0.5px solid var(--rule-strong);
		border-radius: var(--r-control);
		font-family: var(--face-mono);
		letter-spacing: 0;
		text-transform: none;
		color: var(--key-2);
		text-decoration: none;
	}
	.version:hover {
		color: var(--register);
		border-color: var(--register);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 1rem;
	}
	.actions .btn {
		font-size: var(--sl-text-sm);
		padding: 0.5rem 1rem;
	}
	@media (max-width: 64rem) {
		.claim {
			grid-template-columns: minmax(0, 1fr);
		}
		h1 {
			white-space: normal;
			text-wrap: balance;
		}
		.side {
			margin-top: 1.5rem;
		}
	}
</style>
