---
/**
 * The front page's graph: this site's claim and its pages, as a Graphviz graph laid out by
 * the port. Before any script runs it is the port's own -Tsvg, rendered at build time for
 * both themes and both orientations; once the WASM build loads in a worker, every frame is
 * a live layout (src/lib/home/live.ts).
 */
import '@fontsource/tinos/400.css';
import '@fontsource/tinos/400-italic.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { fidelity, url } from '../../lib/data';
import { buildHost, buildRuntime, renderAtBuild } from '../../lib/home/build';
import { ENGINES, homeSource, type Figures } from '../../lib/home/source';

const hasCrossPlatform = existsSync(join(process.cwd(), 'src/pages/cross-platform.astro'));
const figures: Figures = {
	apple: fidelity.e2e.apple,
	portable: fidelity.e2e.portable,
	total: fidelity.e2e.total,
	links: {
		fidelity: url('fidelity/'),
		gallery: url('gallery/'),
		verify: url('verify/'),
		playground: url('playground/'),
		left: url('whats-left/'),
		api: url('api/'),
		notes: url('porting/dotgen/'),
		...(hasCrossPlatform ? { platforms: url('cross-platform/') } : {}),
	},
};

const variants = [];
const builds: Record<string, { bytes: number; sha256: string }> = {};
for (const theme of ['light', 'dark'] as const)
	for (const rankdir of ['LR', 'TB'] as const) {
		const r = await renderAtBuild(homeSource(figures, { engine: 'dot', rankdir, theme }), 'dot');
		if (!r) continue;
		const id = `${theme}-${rankdir}`;
		builds[id] = { bytes: r.bytes, sha256: r.sha256 };
		const [, w, h] = r.svg.match(/<svg width="([\d.]+)pt" height="([\d.]+)pt"/) ?? [];
		// Graphviz's own SVG, inline: its <a> elements are the links, its <title>s the tooltips.
		const html = r.svg
			.replace(/^[\s\S]*?(?=<svg)/, '')
			.replace(/<!--[\s\S]*?-->\n?/g, '')
			.replace(/\sid="[^"]*"/g, '')
			.replace(
				/<svg width="[^"]*" height="[^"]*"/,
				`<svg class="static v-${id}" role="img" aria-label="The graph of this site, drawn by graphvis-rs at build time" style="max-width:${((+w * 4) / 3).toFixed(0)}px;max-height:${((+h * 4) / 3).toFixed(0)}px"`,
			);
		variants.push(html);
	}
const initial = homeSource(figures, { engine: 'dot', rankdir: 'LR', theme: 'light' });
const host = `${buildHost} (${buildRuntime})`;
---

<section
	class="gv-live not-content"
	data-live-graph
	data-state="static"
	data-format="svg"
	data-figures={JSON.stringify(figures)}
	data-builds={JSON.stringify(builds)}
	data-host={host}
	aria-label="Live graph"
>
	<div class="cmd" role="toolbar" aria-label="The command that draws the graph">
		<span class="prompt" aria-hidden="true">$</span>
		<code class="bin">dot-rs</code>
		<span class="flag" aria-hidden="true">-K</span>
		<span class="opts" role="group" aria-label="Layout engine (-K)">
			{ENGINES.map((e, i) => <button type="button" class="node-btn" data-k={e} aria-pressed={i === 0 ? 'true' : 'false'} disabled>{e}</button>)}
		</span>
		<span class="flag" aria-hidden="true">-T</span>
		<span class="opts" role="group" aria-label="Output format (-T)">
			<button type="button" class="node-btn" data-t="svg" aria-pressed="true" disabled>svg</button>
			<button type="button" class="node-btn" data-t="png" aria-pressed="false" disabled>png</button>
		</span>
		<code class="file">home.gv</code>
	</div>

	<div class="paper" data-sheet>
		<Fragment set:html={variants.join('\n')} />
		{variants.length === 0 && <p class="nodraw">This build has no WASM package, so no drawing: run <code>scripts/site-wasm.sh</code>.</p>}
		<p class="hint" aria-hidden="true">Drag any node. Click a box to follow it, an engine to switch.</p>
	</div>

	<div class="readout">
		<p class="status mono" data-status aria-live="polite">Rendered by graphvis-rs when this site was built.</p>
		<p class="proof" data-proof aria-live="polite"></p>
		<div class="tools">
			<button type="button" class="btn" data-unpin hidden>Unpin all <kbd>Esc</kbd></button>
			<details class="src">
				<summary>DOT source of this frame</summary>
				<pre data-src>{initial}</pre>
			</details>
		</div>
	</div>
</section>

<script>
	import { mountLive } from '../../lib/home/live';
	for (const el of document.querySelectorAll<HTMLElement>('[data-live-graph]')) mountLive(el);
</script>

<style>
	.gv-live {
		--gv-times: Times, Tinos, 'Times New Roman', serif;
		--paper: #ffffff;
		--paper-ink: #000000;
		/* X11 colour names, as the graph uses them */
		--x11-lightgoldenrod1: #ffec8b;
		--x11-lightblue2: #b2dfee;
		--x11-gray50: #7f7f7f;
		display: grid;
		gap: 0;
		margin-top: 1.5rem;
	}
	:global([data-theme='dark']) .gv-live {
		--paper: #15181d;
		--paper-ink: #e0e0e0;
		--x11-lightgoldenrod1: #cd9b1d; /* goldenrod3, the dark graph's pick */
	}

	/* ---------- The command line ---------- */
	.cmd {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		padding: 0.75rem 1rem;
		border: 0.5px solid var(--rule-strong);
		border-bottom: 0;
		border-radius: var(--r-panel) var(--r-panel) 0 0;
		background: var(--stock-raised);
		font-family: var(--face-mono);
		font-size: var(--sl-text-sm);
		color: var(--key-2);
	}
	.prompt {
		color: var(--key-4);
	}
	.bin,
	.file {
		font-size: 1em;
		color: var(--key);
		background: none;
		border: 0;
		padding: 0;
	}
	.file {
		color: var(--key-3);
	}
	.flag {
		color: var(--key);
		margin-right: -0.25rem;
	}
	.opts {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.25rem;
	}
	/* A button drawn like a Graphviz node: a hairline ellipse with a Times label. */
	.node-btn {
		font-family: var(--gv-times);
		font-size: 0.9375rem;
		line-height: 1;
		padding: 0.3125rem 0.75rem;
		border-radius: 50%;
		border: 1px solid var(--key-3);
		color: var(--key);
		background: transparent;
		cursor: pointer;
		white-space: nowrap;
		transition: background-color 150ms ease-out, border-color 150ms ease-out;
	}
	.node-btn:hover:not(:disabled):not([aria-pressed='true']) {
		border-color: var(--key);
		background: var(--control-hover);
	}
	.node-btn:active:not(:disabled) {
		transform: translateY(0.5px);
	}
	.node-btn[aria-pressed='true'] {
		background: var(--x11-lightgoldenrod1);
		border-color: var(--key);
		color: #000;
	}
	.node-btn:disabled {
		cursor: progress;
		opacity: 0.55;
	}
	.node-btn:focus-visible {
		outline: 1px dashed var(--key);
		outline-offset: 3px;
	}

	/* ---------- The paper ---------- */
	.paper {
		position: relative;
		display: grid;
		place-items: center;
		height: clamp(22rem, calc(100vh - 22rem), 34rem);
		background: var(--paper);
		border: 0.5px solid var(--rule-strong);
		overflow: hidden;
		user-select: none;
		-webkit-user-select: none;
	}
	.paper > :global(svg) {
		grid-area: 1 / 1;
		width: 100%;
		height: 100%;
	}
	.paper :global(svg text) {
		font-family: var(--gv-times);
	}
	.paper > :global(.static) {
		display: none;
	}
	:global(:root:not([data-theme='dark'])) .paper > :global(.v-light-LR),
	:global([data-theme='dark']) .paper > :global(.v-dark-LR) {
		display: block;
	}
	.paper > :global(.live) {
		position: absolute;
		inset: 0;
		touch-action: pan-y;
		overflow: visible;
	}
	.gv-live[data-state='live'] .paper > :global(.static) {
		display: none !important;
	}
	.paper > :global(.raster) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		display: none;
		pointer-events: none;
	}
	.gv-live[data-format='png'] .paper > :global(.raster) {
		display: block;
	}
	.gv-live[data-format='png'] .paper :global(.live .scene) {
		opacity: 0;
	}
	.paper :global(.live .node) {
		cursor: grab;
		touch-action: none;
		outline: none;
	}
	.paper :global(.live .node .hit) {
		fill: transparent;
		stroke: none;
	}
	.gv-live:global(.dragging) .paper,
	.gv-live:global(.dragging) .paper :global(.live .node) {
		cursor: grabbing;
	}
	.paper :global(.live a.node:hover text) {
		text-decoration: underline;
		text-decoration-thickness: 0.5px;
	}
	.paper :global(.live .ring) {
		fill: none;
		stroke: var(--paper-ink);
		stroke-width: 1;
		stroke-dasharray: 5, 2;
		pointer-events: none;
	}
	.hint {
		position: absolute;
		z-index: 1;
		right: 1rem;
		top: 0.75rem;
		margin: 0;
		font-family: var(--gv-times);
		font-style: italic;
		font-size: 0.9375rem;
		color: var(--x11-gray50);
		pointer-events: none;
		transition: opacity 250ms ease-out;
	}
	.gv-live[data-state='static'] .hint {
		opacity: 0;
	}
	.gv-live:global(.dragging) .hint,
	.gv-live:global(.touched) .hint {
		opacity: 0;
	}
	.nodraw {
		color: var(--key-3);
		font-size: var(--sl-text-sm);
	}

	/* ---------- The readout ---------- */
	.readout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.25rem 1.5rem;
		align-items: start;
		padding: 0.75rem 1rem;
		border: 0.5px solid var(--rule-strong);
		border-top: 0;
		border-radius: 0 0 var(--r-panel) var(--r-panel);
		background: var(--stock-raised);
		font-size: var(--sl-text-xs);
	}
	.status {
		margin: 0;
		color: var(--key-2);
		font-size: var(--sl-text-2xs);
		line-height: 1.6;
	}
	.proof {
		grid-column: 1;
		margin: 0;
		color: var(--key-3);
		line-height: 1.55;
	}
	.proof:empty {
		display: none;
	}
	.proof[data-state='same']::before {
		content: '';
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: var(--register);
		vertical-align: 0.05em;
	}
	.proof[data-state='differs'] {
		color: var(--m-ink);
	}
	.proof :global(code) {
		font-size: 0.95em;
	}
	.tools {
		grid-column: 2;
		grid-row: 1 / span 2;
		display: flex;
		gap: 0.75rem;
		align-items: start;
	}
	.tools [hidden] {
		display: none;
	}
	.tools kbd {
		font-family: var(--face-mono);
		font-size: 0.85em;
		color: var(--key-3);
	}
	.src summary {
		cursor: pointer;
		color: var(--key-2);
		font-weight: 560;
		white-space: nowrap;
		padding: 0.375rem 0;
	}
	.src summary:hover {
		color: var(--key);
	}
	.src[open] {
		grid-column: 1 / -1;
	}
	.src pre {
		position: absolute;
		right: 1rem;
		left: 1rem;
		z-index: 2;
		max-height: 22rem;
		overflow: auto;
		margin: 0.5rem 0 0;
		padding: 0.75rem;
		font-size: var(--sl-text-2xs);
		line-height: 1.5;
		background: var(--stock-sunk);
		border: 0.5px solid var(--rule-default);
		border-radius: var(--r-panel);
		color: var(--key-2);
	}
	.readout {
		position: relative;
	}

	@media (max-width: 45rem) {
		.paper {
			height: auto;
			aspect-ratio: 440 / 855;
			max-height: 52rem;
		}
		:global(:root:not([data-theme='dark'])) .paper > :global(.v-light-LR),
		:global([data-theme='dark']) .paper > :global(.v-dark-LR) {
			display: none;
		}
		:global(:root:not([data-theme='dark'])) .paper > :global(.v-light-TB),
		:global([data-theme='dark']) .paper > :global(.v-dark-TB) {
			display: block;
		}
		.cmd {
			padding: 0.75rem;
			gap: 0.375rem 0.5rem;
		}
		.node-btn {
			font-size: 0.875rem;
			padding: 0.3125rem 0.5rem;
		}
		.readout {
			grid-template-columns: minmax(0, 1fr);
		}
		.tools {
			grid-column: 1;
			grid-row: auto;
		}
		.hint {
			left: 0.75rem;
			right: 0.75rem;
			top: auto;
			bottom: 0.5rem;
		}
	}
</style>
