---
import Bar from './Bar.astro';
import { fidelity, fmt } from '../../lib/data';
const rows = fidelity.layout;
---
<div class="scroll-x"><table class="ledger">
	<thead><tr><th>Corpus</th><th class="n">Files</th><th class="n">macOS exact</th><th class="n">Linux, WASM exact</th><th>Not exact (macOS)</th></tr></thead>
	<tbody>
		{rows.map((r) => (
			<tr>
				<td><strong>{r.name}</strong></td>
				<td class="n">{fmt(r.total)}</td>
				<td class="n">{fmt(r.apple)}<Bar a={r.apple} b={r.total} /></td>
				<td class="n">{fmt(r.portable)}<Bar a={r.portable} b={r.total} /></td>
				<td class="files">{r.apple_inexact.length ? r.apple_inexact.map((f) => <code>{f}</code>) : '·'}</td>
			</tr>
		))}
	</tbody>
</table></div>
<style>
	.files { font-size: var(--sl-text-2xs); }
	.files code { display: inline-block; margin: 0 0.25rem 0.25rem 0; font-size: 1em; }
</style>
