---
import { fidelity } from '../../lib/data';
const d = fidelity.e2e.differs;
---
<details class="dlist">
	<summary>The {d.portable.length} files that differ under portable math{d.apple.length ? `, and the ${d.apple.length} that differ on macOS` : ''}</summary>
	<ul class="mono">{d.portable.map((f) => <li>{f}</li>)}</ul>
	{d.apple.length > 0 && <ul class="mono">{d.apple.map((f) => <li>{f}</li>)}</ul>}
</details>
<details class="dlist">
	<summary>The {fidelity.e2e.unstable.length} inputs skipped because C's output changes between two runs</summary>
	<ul class="mono">{fidelity.e2e.unstable.map((f) => <li>{f}</li>)}</ul>
</details>
<style>
	.dlist { margin-block: 0.5rem; font-size: var(--sl-text-sm); }
	.dlist summary { cursor: pointer; color: var(--key-2); }
	.dlist ul { columns: 2 18rem; font-size: var(--sl-text-2xs); list-style: none; padding: 0.75rem; margin-top: 0.5rem; background: var(--stock-sunk); border: 0.5px solid var(--rule); border-radius: var(--r-control); }
	.dlist li { margin: 0; break-inside: avoid; }
</style>
