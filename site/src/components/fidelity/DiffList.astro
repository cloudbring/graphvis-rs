---
import { fidelity } from '../../lib/data';
interface Props { stock?: boolean }
const { stock = false } = Astro.props;
const e = fidelity.e2e;
const st = e.stock;
const other = new Set<string>(st.other);
---
{stock ? (
	<details class="dlist">
		<summary>The {st.differs.length} files that differ from stock C on macOS{st.other.length ? `, ${st.libm_only} of them only through Apple's libm` : ", all only through Apple's libm"}</summary>
		<ul class="mono">{st.differs.map((f) => <li>{f}{other.has(f) && ' (also differs from C with the same math)'}</li>)}</ul>
	</details>
) : <>
{e.differs.length > 0 && (
	<details class="dlist">
		<summary>The {e.differs.length} files that differ from C with the same math</summary>
		<ul class="mono">{e.differs.map((f) => <li>{f}</li>)}</ul>
	</details>
)}
<details class="dlist">
	<summary>The {e.unstable.length} inputs skipped because C's output changes between two runs</summary>
	<ul class="mono">{e.unstable.map((f) => <li>{f}</li>)}</ul>
</details>
</>}
<style>
	.dlist { margin-block: 0.5rem; font-size: var(--sl-text-sm); }
	.dlist summary { cursor: pointer; color: var(--key-2); }
	.dlist ul { columns: 2 18rem; font-size: var(--sl-text-2xs); list-style: none; padding: 0.75rem; margin-top: 0.5rem; background: var(--stock-sunk); border: 0.5px solid var(--rule); border-radius: var(--r-control); }
	.dlist li { margin: 0; break-inside: avoid; }
</style>
