---
/** Registration bar: the identical share in register blue, the rest magenta. */
interface Props { a: number; b: number; }
const { a, b } = Astro.props;
const w = b ? (100 * a) / b : 0;
---
<span class="rbar" role="img" aria-label={`${a} of ${b}`}><span style={`width:${w}%`}></span></span>
<style>
	.rbar { display: inline-block; vertical-align: middle; width: 4rem; height: 4px; border-radius: 1px; background: var(--plate-m); overflow: hidden; margin-left: 0.5rem; }
	.rbar span { display: block; height: 100%; background: var(--register); }
</style>
