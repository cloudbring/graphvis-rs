---
/**
 * The press sheet: every file of the full-pipeline check as one patch, per corpus.
 * Blue: byte-identical. Magenta: differs. Yellow: skipped because C's own output changes
 * between runs. Hover a patch for its name.
 */
import { fidelity, fmt } from '../../lib/data';
const e = fidelity.e2e;
const COLS = 84, PITCH = 8, CELL = 6, LABEL = 96, GAP = 8;
const corpora = e.corpora.map((c) => c.name);
const byCorpus = (list: string[]) => {
	const m = new Map<string, string[]>(corpora.map((c) => [c, []]));
	for (const f of list) m.get(f.split('/')[0])?.push(f);
	return m;
};
const files = byCorpus(e.files);
const unstable = byCorpus(e.unstable);

function sheet(profile: 'apple' | 'portable') {
	const off = new Set(e.differs[profile]);
	let y = 0;
	let reg = '';
	const offCells: { x: number; y: number; name: string }[] = [];
	const yCells: { x: number; y: number; name: string }[] = [];
	const labels: { y: number; name: string; n: string }[] = [];
	for (const c of corpora) {
		const list = [...files.get(c)!, ...unstable.get(c)!];
		const un = new Set(unstable.get(c));
		const bad = list.filter((f) => off.has(f)).length;
		labels.push({ y, name: c, n: bad ? `${bad} off` : '' });
		list.forEach((f, i) => {
			const x = LABEL + (i % COLS) * PITCH;
			const yy = y + Math.floor(i / COLS) * PITCH;
			if (un.has(f)) yCells.push({ x, y: yy, name: f });
			else if (off.has(f)) offCells.push({ x, y: yy, name: f });
			else reg += `M${x} ${yy}h${CELL}v${CELL}h-${CELL}z`;
		});
		y += Math.ceil(list.length / COLS) * PITCH + GAP;
	}
	return { reg, offCells, yCells, labels, h: y - GAP, w: LABEL + COLS * PITCH };
}
const sheets = { apple: sheet('apple'), portable: sheet('portable') };
---
<div class="psheet not-content" data-psheet>
	<div class="psheet-bar">
		<div class="seg" role="group" aria-label="Math profile">
			<button type="button" data-p="apple" aria-pressed="true">macOS, Apple libm</button>
			<button type="button" data-p="portable" aria-pressed="false">Linux and WASM, portable math</button>
		</div>
		<p class="psheet-legend">
			<span class="sw reg"></span> identical <span class="sw off"></span> differs <span class="sw y"></span> C unstable, skipped
		</p>
	</div>
	{(['apple', 'portable'] as const).map((p) => {
		const s = sheets[p];
		return (
			<figure data-sheet={p} hidden={p !== 'apple'}>
				<svg viewBox={`0 0 ${s.w} ${s.h}`} width={s.w} role="img" aria-label={`${fmt(e.total)} files, ${fmt(e[p])} identical`}>
					{s.labels.map((l) => (
						<>
							<text x="0" y={l.y + 8} class="cl">{l.name}</text>
							{l.n && <text x="0" y={l.y + 19} class="cn">{l.n}</text>}
						</>
					))}
					<path d={s.reg} class="reg" />
					{s.offCells.map((c) => <rect x={c.x} y={c.y} width="6" height="6" class="off"><title>{c.name}: differs</title></rect>)}
					{s.yCells.map((c) => <rect x={c.x} y={c.y} width="6" height="6" class="y"><title>{c.name}: C unstable, skipped</title></rect>)}
				</svg>
				<figcaption class="mono">{fmt(e[p])} identical · {fmt(e.total - e[p])} differ · {e.unstable.length} skipped</figcaption>
			</figure>
		);
	})}
</div>
<style>
	.psheet { margin-block: 1.5rem; padding: 1rem; border: 0.5px solid var(--rule-default); border-radius: var(--r-panel); background: var(--stock-raised); }
	.psheet-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
	.psheet-legend { margin: 0 !important; display: flex; align-items: center; gap: 0.375rem; font-size: var(--sl-text-xs); color: var(--key-3); }
	.sw { display: inline-block; width: 8px; height: 8px; border-radius: 1px; margin-left: 0.5rem; }
	.sw.reg, svg .reg { background: var(--register); fill: var(--register); }
	.sw.off, svg .off { background: var(--plate-m); fill: var(--plate-m); }
	.sw.y, svg .y { background: var(--plate-y); fill: var(--plate-y); }
	figure { margin: 0; overflow-x: auto; }
	svg { display: block; max-width: 100%; height: auto; }
	svg rect:hover { stroke: var(--key); stroke-width: 1; }
	.cl { font: 600 10px var(--face); fill: var(--key-2); }
	.cn { font: 400 8px var(--face-mono); fill: var(--m-ink); }
	figcaption { margin-top: 0.75rem; font-size: var(--sl-text-2xs); color: var(--key-3); }
</style>
<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-psheet]')) {
		const btns = el.querySelectorAll<HTMLButtonElement>('[data-p]');
		for (const b of btns) b.addEventListener('click', () => {
			for (const x of btns) x.setAttribute('aria-pressed', String(x === b));
			for (const f of el.querySelectorAll<HTMLElement>('[data-sheet]')) f.hidden = f.dataset.sheet !== b.dataset.p;
		});
	}
</script>
