---
/**
 * The press sheet: every file of the full-pipeline check as one patch, per corpus.
 * Blue: byte-identical. Magenta: differs. Yellow: skipped because C's own output changes
 * between runs. Hover a patch for its name.
 *
 * The first sheet is the check: C computing with the same math functions as the port. The
 * second, for information, is the same build against stock C on macOS, which calls Apple's
 * libm; cyan marks the files that differ there only through Apple's libm.
 */
import { fidelity, fmt } from '../../lib/data';
const e = fidelity.e2e;
const st = e.stock;
const COLS = 84, PITCH = 8, CELL = 6, LABEL = 96, GAP = 8;
const corpora = e.corpora.map((c) => c.name);
const byCorpus = (list: string[]) => {
	const m = new Map<string, string[]>(corpora.map((c) => [c, []]));
	for (const f of list) m.get(f.split('/')[0])?.push(f);
	return m;
};
// Every file of either reference, in one order, so the two sheets line up patch for patch.
const files = byCorpus([...new Set([...e.files, ...e.unstable, ...st.unstable])].sort());

type Cell = { x: number; y: number; name: string };
type Status = 'reg' | 'off' | 'libm' | 'y';
const TITLE: Record<Status, string> = { reg: 'identical', off: 'differs', libm: "differs only through Apple's libm", y: 'C unstable, skipped' };

function sheet(status: (f: string) => Status) {
	let y = 0;
	let reg = '';
	const cells: Record<'off' | 'libm' | 'y', Cell[]> = { off: [], libm: [], y: [] };
	const labels: { y: number; name: string; n: string }[] = [];
	for (const c of corpora) {
		const list = files.get(c)!;
		let bad = 0;
		list.forEach((f, i) => {
			const x = LABEL + (i % COLS) * PITCH;
			const yy = y + Math.floor(i / COLS) * PITCH;
			const k = status(f);
			if (k === 'reg') reg += `M${x} ${yy}h${CELL}v${CELL}h-${CELL}z`;
			else cells[k].push({ x, y: yy, name: f });
			if (k === 'off' || k === 'libm') bad++;
		});
		labels.push({ y, name: c, n: bad ? `${bad} off` : '' });
		y += Math.ceil(list.length / COLS) * PITCH + GAP;
	}
	return { reg, cells, labels, h: y - GAP, w: LABEL + COLS * PITCH };
}

// The two references share their inputs; they differ only in which ones C reproduces from run to run.
const sameUn = new Set<string>(e.unstable), sameOff = new Set<string>(e.differs);
const stockUn = new Set<string>(st.unstable), stockOff = new Set<string>(st.differs), stockOther = new Set<string>(st.other);
const sheets = [
	{
		id: 'same',
		button: 'C with the same math',
		caption: `${fmt(e.identical)} identical · ${fmt(e.total - e.identical)} differ · ${e.unstable.length} skipped`,
		label: `${fmt(e.total)} files, ${fmt(e.identical)} identical to C with the same math`,
		...sheet((f) => (sameUn.has(f) ? 'y' : sameOff.has(f) ? 'off' : 'reg')),
	},
	{
		id: 'stock',
		button: 'Stock C on macOS, informational',
		caption: `${fmt(st.identical)} identical · ${fmt(st.libm_only)} differ only through Apple's libm · ${fmt(st.other.length)} otherwise · ${st.unstable.length} skipped`,
		label: `${fmt(st.total)} files, ${fmt(st.identical)} identical to stock C on macOS`,
		...sheet((f) => (stockUn.has(f) ? 'y' : stockOther.has(f) ? 'off' : stockOff.has(f) ? 'libm' : 'reg')),
	},
];
---
<div class="psheet not-content" data-psheet>
	<div class="psheet-bar">
		<div class="seg" role="group" aria-label="C reference">
			{sheets.map((s, i) => <button type="button" data-p={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.button}</button>)}
		</div>
		<p class="psheet-legend">
			<span class="sw reg"></span> identical <span class="sw off"></span> differs <span class="sw libm"></span> Apple's libm only <span class="sw y"></span> C unstable, skipped
		</p>
	</div>
	{sheets.map((s, i) => (
		<figure data-sheet={s.id} hidden={i !== 0}>
			<svg viewBox={`0 0 ${s.w} ${s.h}`} width={s.w} role="img" aria-label={s.label}>
				{s.labels.map((l) => (
					<>
						<text x="0" y={l.y + 8} class="cl">{l.name}</text>
						{l.n && <text x="0" y={l.y + 19} class="cn">{l.n}</text>}
					</>
				))}
				<path d={s.reg} class="reg" />
				{(['off', 'libm', 'y'] as const).map((k) => s.cells[k].map((c) => <rect x={c.x} y={c.y} width="6" height="6" class={k}><title>{c.name}: {TITLE[k]}</title></rect>))}
			</svg>
			<figcaption class="mono">{s.caption}</figcaption>
		</figure>
	))}
</div>
<style>
	.psheet { margin-block: 1.5rem; padding: 1rem; border: 0.5px solid var(--rule-default); border-radius: var(--r-panel); background: var(--stock-raised); }
	.psheet-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
	.psheet-legend { margin: 0 !important; display: flex; align-items: center; gap: 0.375rem; font-size: var(--sl-text-xs); color: var(--key-3); }
	.sw { display: inline-block; width: 8px; height: 8px; border-radius: 1px; margin-left: 0.5rem; }
	.sw.reg, svg .reg { background: var(--register); fill: var(--register); }
	.sw.off, svg .off { background: var(--plate-m); fill: var(--plate-m); }
	.sw.libm, svg .libm { background: var(--plate-c); fill: var(--plate-c); }
	.sw.y, svg .y { background: var(--plate-y); fill: var(--plate-y); }
	figure { margin: 0; overflow-x: auto; }
	svg { display: block; max-width: 100%; height: auto; }
	svg rect:hover { stroke: var(--key); stroke-width: 1; }
	.cl { font: 600 10px var(--face); fill: var(--key-2); }
	.cn { font: 400 8px var(--face-mono); fill: var(--m-ink); }
	figcaption { margin-top: 0.75rem; font-size: var(--sl-text-2xs); color: var(--key-3); }
</style>
<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-psheet]')) {
		const btns = el.querySelectorAll<HTMLButtonElement>('[data-p]');
		for (const b of btns) b.addEventListener('click', () => {
			for (const x of btns) x.setAttribute('aria-pressed', String(x === b));
			for (const f of el.querySelectorAll<HTMLElement>('[data-sheet]')) f.hidden = f.dataset.sheet !== b.dataset.p;
		});
	}
</script>
