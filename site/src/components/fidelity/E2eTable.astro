---
import Bar from './Bar.astro';
import { fidelity, fmt } from '../../lib/data';
const e = fidelity.e2e;
const st = e.stock;
const stockOf = (name: string) => st.corpora.find((c) => c.name === name)!;
---
<div class="scroll-x"><table class="ledger">
	<thead>
		<tr><th>Corpus</th><th>Inputs</th><th class="n">Files</th><th class="n">Identical</th><th class="n">C unstable, skipped</th><th class="n info">Stock C on macOS</th></tr>
	</thead>
	<tbody>
		{e.corpora.map((c) => {
			const s = stockOf(c.name);
			return (
				<tr>
					<td><strong>{c.name}</strong></td>
					<td><code>{c.dirs}</code></td>
					<td class="n">{fmt(c.total)}</td>
					<td class="n">{fmt(c.identical)}<Bar a={c.identical} b={c.total} /></td>
					<td class="n">{c.unstable || '·'}</td>
					<td class="n info">{fmt(s.identical)}<small>/{fmt(s.total)}</small></td>
				</tr>
			);
		})}
	</tbody>
	<tfoot>
		<tr><th>Total</th><th></th><th class="n">{fmt(e.total)}</th><th class="n">{fmt(e.identical)}<Bar a={e.identical} b={e.total} /></th><th class="n">{e.unstable.length}</th><th class="n info">{fmt(st.identical)}<small>/{fmt(st.total)}</small></th></tr>
	</tfoot>
</table></div>
<style>
	tfoot th { padding-top: 0.75rem; border-bottom: 0; font-weight: 650; color: var(--key); }
	td code { font-size: 0.8em; }
	.info { color: var(--key-3); }
	.info small { font-size: 0.85em; }
</style>
