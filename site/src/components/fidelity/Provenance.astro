---
import Mark from '../Mark.astro';
import { fidelity, REPO } from '../../lib/data';
const f = fidelity;
const when = f.generated.replace('T', ' ').replace('+00:00', ' UTC');
---
<style is:global>
	:root { --sl-content-width: 54rem; }
	.ledger code { white-space: nowrap; }
</style>
<dl class="prov not-content">
	<div><dt class="label">Commit</dt><dd class="mono"><a href={`${REPO}/commit/${f.commit}`}>{f.commit_short}</a> · {f.commit_date.slice(0, 10)}</dd></div>
	<div><dt class="label">Generated</dt><dd class="mono">{when}</dd></div>
	<div>
		<dt class="label">Source</dt>
		<dd>
			{f.source === 'measured'
				? <Mark kind="register" label={`Measured: gv-diff e2e run under ${[f.measured.apple && 'Apple', f.measured.portable && 'portable'].filter(Boolean).join(' and ')} math on ${f.measured_on}, matching the committed baselines`} />
				: <Mark kind="pending" label="Counted from the committed baselines (not re-measured)" />}
		</dd>
	</div>
	<div><dt class="label">Reference</dt><dd>C Graphviz {f.oracle.version}, no Pango plugin</dd></div>
</dl>
<style>
	.prov { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.75rem 1.5rem; margin: 0 0 2rem; padding: 0.75rem 0; border-block: 0.5px solid var(--rule-default); }
	.prov div { margin: 0; }
	.prov dt { margin: 0; }
	.prov dd { margin: 0.25rem 0 0; font-size: var(--sl-text-xs); color: var(--key-2); }
	.prov :global(.mark) { white-space: normal; line-height: 1.4; align-items: flex-start; }
	.prov a { color: var(--register); }
</style>
