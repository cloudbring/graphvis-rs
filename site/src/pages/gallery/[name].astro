---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import DiffViewer from '../../components/DiffViewer.astro';
import LiveCheck from '../../components/LiveCheck.astro';
import Mark from '../../components/Mark.astro';
import { cmdline, fmt, samples, sourceUrl, url, type Sample } from '../../lib/data';

export function getStaticPaths() {
	return samples.map((s, i) => ({ params: { name: s.name }, props: { s, prev: samples[i - 1], next: samples[i + 1] } }));
}
interface Props {
	s: Sample;
	prev?: Sample;
	next?: Sample;
}
const { s, prev, next } = Astro.props;
const dir = `samples/${s.name}/`;
const input = readFileSync(join(process.cwd(), 'public', dir, 'input.gv'), 'utf8');
const lines = input.split('\n').length;
const file = s.source.split('/').pop()!;
---

<StarlightPage
	frontmatter={{
		title: s.title,
		description: `${s.title}: C Graphviz 16.1.0 and graphviz-pure output for ${s.source}, compared byte for byte and pixel for pixel.`,
		tableOfContents: false,
	}}
>
	<style is:global>
		:root {
			--sl-content-width: 64rem;
		}
	</style>
	<dl class="meta not-content">
		<div><dt class="label">Engine</dt><dd><code>{s.engine}</code></dd></div>
		<div class="wide"><dt class="label">Command, both sides</dt><dd><code>{cmdline(s)}</code></dd></div>
		<div class="wide">
			<dt class="label">Input</dt>
			<dd><a href={sourceUrl(s)}><code>{s.source}</code></a> · {fmt(s.bytes.input)} bytes</dd>
		</div>
		<div><dt class="label">Features</dt><dd class="chips">{s.features.map((f) => <span class="chip">{f}</span>)}</dd></div>
		<div>
			<dt class="label">Result</dt>
			<dd class="marks">
				{s.identical ? <Mark kind="register" label="identical on macOS" /> : <Mark kind="off" label="differs on macOS" />}
				{s.identical_portable ? (
					<Mark kind="register" label="identical under portable math" />
				) : (
					<Mark kind="upstream" label="differs under portable math" />
				)}
			</dd>
		</div>
	</dl>

	{
		!s.identical_portable && (
			<p class="why">
				This sample is here because it differs: under the portable math library used on Linux and in WASM, {s.engine === 'sfdp' ? "sfdp's multilevel layout" : 'the layout'} turns
				last-bit differences in <code>pow</code>, <code>sin</code> or <code>cos</code> into a different drawing. The viewer compares the macOS build, which matches C; the live check
				below runs the portable build in your browser and can load its output into the viewer. <a href={url('porting/libm/')}>Math off macOS</a>
			</p>
		)
	}

	<DiffViewer id="viewer" c={url(dir + 'c.svg')} rust={url(dir + 'rust.svg')} rightLabel="graphviz-pure, native macOS build" />

	<LiveCheck
		input={url(dir + s.wasm_input)}
		c={url(dir + 'c.svg')}
		engine={s.engine}
		expectIdentical={s.identical_portable}
		viewer="viewer"
		injected={s.flags.map((f) => f.replace(/^-G/, '') + ';')}
	/>

	<h2 id="input">Input</h2>
	{
		lines > 60 ? (
			<details class="src">
				<summary>
					{file}, {lines} lines
				</summary>
				<Code code={input} lang="txt" />
			</details>
		) : (
			<Code code={input} lang="txt" title={file} />
		)
	}

	<h2 id="files">Files</h2>
	<table class="ledger">
		<thead><tr><th>File</th><th class="n">Bytes</th><th>SHA-256</th></tr></thead>
		<tbody>
			<tr><td><a href={url(dir + 'input.gv')}>input.gv</a></td><td class="n">{fmt(s.bytes.input)}</td><td></td></tr>
			<tr>
				<td><a href={url(dir + 'c.svg')}>c.svg</a> <span class="chip c">C</span></td>
				<td class="n">{fmt(s.bytes.c)}</td>
				<td class="sha mono">{s.sha256.c}</td>
			</tr>
			<tr>
				<td><a href={url(dir + 'rust.svg')}>rust.svg</a> <span class="chip m">Rust</span></td>
				<td class="n">{fmt(s.bytes.rust)}</td>
				<td class="sha mono">{s.sha256.rust}</td>
			</tr>
		</tbody>
	</table>
	<p class="note">
		The two hashes differ even when the outputs are identical, because each file keeps its own generator comment. Made by <code
			>scripts/site-samples.sh</code
		>.
	</p>

	<nav class="pn" aria-label="Other samples">
		{prev ? <a href={url(`gallery/${prev.name}/`)}><span class="label">Previous</span>{prev.title}</a> : <span />}
		<a href={url('gallery/')} class="all">All samples</a>
		{next ? <a href={url(`gallery/${next.name}/`)} class="r"><span class="label">Next</span>{next.title}</a> : <span />}
	</nav>
</StarlightPage>

<style>
	.meta {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1rem 1.5rem;
		margin: 0;
		padding: 0.75rem 0 1rem;
		border-bottom: 0.5px solid var(--rule-default);
	}
	.meta div {
		margin: 0;
		min-width: 0;
	}
	.meta .wide {
		grid-column: span 2;
	}
	.meta dt {
		margin: 0;
	}
	.meta dd {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
	}
	.meta dd code {
		font-size: 0.86em;
		word-break: break-all;
	}
	.marks :global(.mark) {
		white-space: normal;
	}
	.chips,
	.marks {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem 0.75rem;
	}
	.why {
		font-size: var(--sl-text-sm);
		color: var(--key-2);
		padding: 0.75rem 1rem;
		border-left: 2px solid var(--plate-y);
		background: var(--y-wash);
		border-radius: 0 var(--r-panel) var(--r-panel) 0;
	}
	.sha {
		font-size: var(--sl-text-2xs);
		color: var(--key-3);
		word-break: break-all;
	}
	.note {
		font-size: var(--sl-text-xs);
		color: var(--key-3);
	}
	.src summary {
		cursor: pointer;
		color: var(--key-2);
		font-size: var(--sl-text-sm);
		margin-bottom: 0.5rem;
	}
	.pn {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 1rem;
		align-items: end;
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 0.5px solid var(--rule-strong);
	}
	.pn a {
		display: grid;
		gap: 0.25rem;
		color: var(--register);
		text-decoration: none;
		font-weight: 600;
		font-size: var(--sl-text-sm);
	}
	.pn a:hover {
		text-decoration: underline;
	}
	.pn .r {
		text-align: right;
	}
	.pn .all {
		font-weight: 500;
	}
	@media (max-width: 50rem) {
		.meta {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
