---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import IssueRow from '../../components/IssueRow.astro';
import { ENGINES, fidelity, fmt, issues, severityRank, url } from '../../lib/data';
import { portBugs, upstream } from '../../lib/issues';

const engines = ENGINES.filter((e) => issues.some((i) => i.engine === e)).concat(
	[...new Set(issues.map((i) => i.engine))].filter((e) => !ENGINES.includes(e)),
);
const severities = [...new Set(issues.map((i) => i.severity))].sort((a, b) => severityRank(a) - severityRank(b));
const count = (sev: string, eng: string) => issues.filter((i) => i.severity === sev && i.engine === eng).length;
const twopi = fidelity.layout.find((l) => l.name === 'twopi')!;
const lastFuzz = fidelity.fuzz.rounds[fidelity.fuzz.rounds.length - 1];
---

<StarlightPage frontmatter={{ title: "What's left", description: 'Open differences between graphvis-rs and C Graphviz 16.1.0: bugs in the port, and C behaviour the port does not or should not reproduce.' }} headings={[{ depth: 2, slug: 'port', text: 'In the port' }, { depth: 2, slug: 'upstream', text: 'Upstream C behaviour' }, { depth: 2, slug: 'known', text: 'In numbers' }]}>
	<p class="intro">
		Everything known not to match, each with a minimised reproducer, C's output and the port's. <strong>In the port</strong> means the port
		should change. <strong>Upstream C behaviour</strong> means C's output comes from undefined behaviour, a crash path or nondeterminism, so it
		cannot or should not be reproduced byte for byte; the port should still behave sensibly there.
	</p>

	{issues.length > 0 && (
		<table class="ledger matrix">
			<thead><tr><th>Severity</th>{engines.map((e) => <th class="n">{e}</th>)}<th class="n">Total</th></tr></thead>
			<tbody>
				{severities.map((s) => (
					<tr><td>{s}</td>{engines.map((e) => <td class="n">{count(s, e) || '·'}</td>)}<td class="n">{issues.filter((i) => i.severity === s).length}</td></tr>
				))}
			</tbody>
		</table>
	)}

	<h2 id="port">In the port <span class="n">{portBugs.length}</span></h2>
	{portBugs.length ? <ul class="list">{portBugs.map((i) => <IssueRow i={i} />)}</ul> : <p class="empty">No open port bugs.</p>}

	<h2 id="upstream">Upstream C behaviour <span class="n">{upstream.length}</span></h2>
	{upstream.length ? <ul class="list">{upstream.map((i) => <IssueRow i={i} />)}</ul> : <p class="empty">None recorded.</p>}

	<h2 id="known">In numbers</h2>
	<ul class="known">
		<li><strong>{fmt(fidelity.e2e.total - fidelity.e2e.portable)} corpus files under portable math</strong> (Linux, WASM). Apple's libm is closed source; see <a href={url('whats-left/platform-libm-apple/')}>the issue</a>, <a href={url('porting/libm/')}>Math off macOS</a> and the <a href={url('fidelity/#full-pipeline')}>file list</a>.</li>
		<li><strong>{twopi.total - twopi.apple} twopi layouts</strong>: C routes the arrows graphs differently from run to run (<a href={url('whats-left/twopi-arrows-c-nondeterministic-routing/')}>issue</a>).</li>
		<li><strong>{(100 - lastFuzz.all).toFixed(1)}% of the last fuzzing round</strong>: every remaining case belongs to one of the issues above; the round-by-round record is in <a href={url('porting/fuzzing/')}>the fuzzing notes</a>.</li>
		<li><strong>stderr</strong>: exit status matches; some warning texts and the wording of DOT syntax errors do not (<a href={url('whats-left/stderr-missing-warnings/')}>warnings</a>, <a href={url('whats-left/stderr-syntax-error-message/')}>syntax errors</a>).</li>
	</ul>
</StarlightPage>

<style>
	.intro { color: var(--key-2); }
	.matrix { margin-top: 1.5rem; max-width: 40rem; }
	h2 .n { font-family: var(--face-mono); font-size: var(--sl-text-sm); font-weight: 400; color: var(--key-3); margin-left: 0.5rem; }
	.list { list-style: none; padding: 0; margin: 0; border-top: 0.5px solid var(--rule-strong); }
	.empty { color: var(--key-3); }
	.known li { color: var(--key-2); }
	.known strong { color: var(--key); }
	.known a { color: var(--register); }
</style>
